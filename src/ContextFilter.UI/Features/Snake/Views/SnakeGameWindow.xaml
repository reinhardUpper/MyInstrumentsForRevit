<Window x:Class="ContextFilter.UI.Views.SnakeGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake"
        Width="420"
        Height="500"
        MinWidth="360"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaneBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        KeyDown="OnKeyDown">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Snake"
                       VerticalAlignment="Center"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ScoreText, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold" />
            <Button Grid.Column="2"
                    Content="Restart"
                    Click="OnRestartClick"
                    Style="{StaticResource ToolbarButtonStyle}" />
        </Grid>

        <Border DockPanel.Dock="Bottom"
                Margin="0,10,0,0"
                Padding="8"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderBrush}"
                Background="{StaticResource PanelBrush}"
                CornerRadius="4">
            <TextBlock Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" />
        </Border>

        <Border BorderThickness="1"
                BorderBrush="{StaticResource BorderBrush}"
                Background="#151619"
                CornerRadius="4">
            <Canvas x:Name="GameCanvas"
                    Width="360"
                    Height="360"
                    Focusable="True"
                    Background="#151619"
                    Loaded="OnCanvasLoaded" />
        </Border>
    </DockPanel>
</Window>
