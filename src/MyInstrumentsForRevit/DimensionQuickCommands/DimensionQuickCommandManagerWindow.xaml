<Window x:Class="MyRevitTools.DimensionQuickCommands.DimensionQuickCommandManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#1052;&#1077;&#1085;&#1077;&#1076;&#1078;&#1077;&#1088; &#1088;&#1072;&#1079;&#1084;&#1077;&#1088;&#1085;&#1099;&#1093; &#1082;&#1086;&#1084;&#1072;&#1085;&#1076;"
        Width="820"
        Height="520"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="CommandsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="OnCommandSelectionChanged"
                  Margin="0,0,12,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="&#1057;&#1083;&#1086;&#1090;" Binding="{Binding SlotNumber, StringFormat=&#1041;&#1050;{0}}" Width="64" />
                <DataGridTextColumn Header="&#1048;&#1084;&#1103; &#1082;&#1086;&#1084;&#1072;&#1085;&#1076;&#1099;" Binding="{Binding DisplayName}" Width="*" />
                <DataGridTextColumn Header="&#1058;&#1080;&#1087; &#1088;&#1072;&#1079;&#1084;&#1077;&#1088;&#1072;" Binding="{Binding DimensionTypeName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="&#1048;&#1084;&#1103; &#1082;&#1086;&#1084;&#1072;&#1085;&#1076;&#1099;" />
                    <TextBox x:Name="DisplayNameTextBox"
                             Height="28"
                             Margin="0,4,0,10"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="&#1058;&#1080;&#1087; &#1088;&#1072;&#1079;&#1084;&#1077;&#1088;&#1072;" />
                    <ComboBox x:Name="DimensionTypeComboBox"
                              Height="28"
                              Margin="0,4,0,10"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="IntegerId" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="&#1057;&#1083;&#1086;&#1090; &#1073;&#1099;&#1089;&#1090;&#1088;&#1086;&#1081; &#1082;&#1086;&#1084;&#1072;&#1085;&#1076;&#1099;" />
                    <ComboBox x:Name="SlotComboBox"
                              Height="28"
                              Margin="0,4,0,10"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Number" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           TextWrapping="Wrap"
                           Foreground="#666666"
                           Margin="0,0,0,12"
                           Text="&#1043;&#1086;&#1088;&#1103;&#1095;&#1080;&#1077; &#1082;&#1083;&#1072;&#1074;&#1080;&#1096;&#1080; &#1085;&#1072;&#1079;&#1085;&#1072;&#1095;&#1072;&#1102;&#1090;&#1089;&#1103; &#1095;&#1077;&#1088;&#1077;&#1079; &#1089;&#1090;&#1072;&#1085;&#1076;&#1072;&#1088;&#1090;&#1085;&#1086;&#1077; &#1086;&#1082;&#1085;&#1086; Revit Keyboard Shortcuts. &#1053;&#1072;&#1079;&#1085;&#1072;&#1095;&#1072;&#1081;&#1090;&#1077; &#1082;&#1083;&#1072;&#1074;&#1080;&#1096;&#1091; &#1085;&#1072; &#1089;&#1083;&#1086;&#1090; &#1041;&#1050;1 &#1080;&#1083;&#1080; &#1041;&#1050;2." />

                <UniformGrid Grid.Row="5"
                             Columns="2"
                             Rows="3">
                    <Button Content="&#1057;&#1086;&#1093;&#1088;&#1072;&#1085;&#1080;&#1090;&#1100;"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnSaveClick" />
                    <Button Content="&#1059;&#1076;&#1072;&#1083;&#1080;&#1090;&#1100;"
                            Height="30"
                            Margin="0,0,0,6"
                            Click="OnDeleteClick" />
                    <Button Content="&#1047;&#1072;&#1087;&#1091;&#1089;&#1090;&#1080;&#1090;&#1100;"
                            Height="30"
                            Margin="0,0,6,6"
                            Click="OnRunClick" />
                    <Button Content="&#1054;&#1073;&#1085;&#1086;&#1074;&#1080;&#1090;&#1100; &#1090;&#1080;&#1087;&#1099;"
                            Height="30"
                            Margin="0,0,0,6"
                            Click="OnRefreshTypesClick" />
                    <Button Content="&#1053;&#1086;&#1074;&#1072;&#1103;"
                            Height="30"
                            Margin="0,0,6,0"
                            Click="OnNewClick" />
                    <Button Content="&#1047;&#1072;&#1082;&#1088;&#1099;&#1090;&#1100;"
                            Height="30"
                            IsCancel="True" />
                </UniformGrid>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Margin="0,8,0,0"
                   Foreground="#666666"
                   Text="&#1043;&#1086;&#1090;&#1086;&#1074;&#1086;." />
    </Grid>
</Window>
