<Window x:Class="MyInstrumentsForRevit.Windows.RebarAnchorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x410;&#x43D;&#x43A;&#x435;&#x440;&#x43E;&#x432;&#x43A;&#x430; &#x430;&#x440;&#x43C;&#x430;&#x442;&#x443;&#x440;&#x44B;"
        Width="560"
        Height="500"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3F5F7"
        KeyDown="OnWindowKeyDown"
        Closing="OnWindowClosing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#15202B" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="#FFFFFF"
                                BorderBrush="#D7DEE8"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,7">
                            <StackPanel>
                                <TextBlock x:Name="ValueText"
                                           Text="{TemplateBinding Content}"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock x:Name="HintText"
                                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                           HorizontalAlignment="Center"
                                           Foreground="#64748B"
                                           FontSize="11"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#102A43" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#102A43" />
                                <Setter TargetName="ValueText" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="HintText" Property="Foreground" Value="#B8C7D9" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6EA8FE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="&#x410;&#x43D;&#x43A;&#x435;&#x440;&#x43E;&#x432;&#x43A;&#x430; &#x430;&#x440;&#x43C;&#x430;&#x442;&#x443;&#x440;&#x44B;"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="&#x41A;&#x43B;&#x438;&#x43A; &#x43F;&#x43E; &#x437;&#x43D;&#x430;&#x447;&#x435;&#x43D;&#x438;&#x44E; &#x43A;&#x43E;&#x43F;&#x438;&#x440;&#x443;&#x435;&#x442; &#x434;&#x43B;&#x438;&#x43D;&#x443;. Ctrl+C &#x43A;&#x43E;&#x43F;&#x438;&#x440;&#x443;&#x435;&#x442; &#x432;&#x44B;&#x431;&#x440;&#x430;&#x43D;&#x43D;&#x43E;&#x435; &#x437;&#x43D;&#x430;&#x447;&#x435;&#x43D;&#x438;&#x435;."
                           Margin="0,4,0,0"
                           Foreground="#64748B" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="&#x411;&#x435;&#x442;&#x43E;&#x43D;"
                           Foreground="#64748B"
                           Margin="0,0,0,4" />
                <ComboBox x:Name="ConcreteComboBox"
                          Height="34"
                          SelectionChanged="OnConcreteSelectionChanged" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <TextBlock Text="&#x41A;&#x43E;&#x44D;&#x444;&#x444;&#x438;&#x446;&#x438;&#x435;&#x43D;&#x442; alpha"
                       Foreground="#64748B"
                       Margin="0,0,0,8" />
            <UniformGrid Columns="4">
                <RadioButton x:Name="Alpha09RadioButton" Content="0.9" Tag="&#x441;&#x436;&#x430;&#x442;&#x438;&#x435;" Checked="OnAlphaChecked" />
                <RadioButton x:Name="Alpha10RadioButton" Content="1" Tag="&#x440;&#x430;&#x441;&#x442;&#x44F;&#x436;." Checked="OnAlphaChecked" />
                <RadioButton x:Name="Alpha12RadioButton" Content="1.2" Tag="&#x43D;&#x430;&#x445;&#x43B;&#x435;&#x441;&#x442;" Checked="OnAlphaChecked" />
                <RadioButton x:Name="Alpha20RadioButton" Content="2" Tag="&#x43D;&#x430;&#x445;&#x43B;&#x435;&#x441;&#x442;" Checked="OnAlphaChecked" />
            </UniformGrid>
        </StackPanel>

        <Border x:Name="CurrentValueBorder"
                Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDE4EE"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                MouseLeftButtonUp="OnCurrentValueMouseLeftButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <Button Content="&#x2039;"
                        Width="34"
                        Height="34"
                        Padding="0"
                        FontSize="22"
                        Click="OnPreviousDiameterClick" />

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentDiameterTextBlock"
                               HorizontalAlignment="Center"
                               FontSize="34"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentDescriptionTextBlock"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="#64748B" />
                    <TextBlock x:Name="CurrentLengthTextBlock"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"
                               FontSize="44"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Button Grid.Column="2"
                        Content="&#x203A;"
                        Width="34"
                        Height="34"
                        Padding="0"
                        FontSize="22"
                        Click="OnNextDiameterClick" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Background="#102A43"
                CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SelectedValueTextBlock"
                               Foreground="#FFFFFF"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="#B8C7D9"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="&#x41A;&#x43E;&#x43F;&#x438;&#x440;&#x43E;&#x432;&#x430;&#x442;&#x44C;"
                        MinWidth="110"
                        Click="OnCopyClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
