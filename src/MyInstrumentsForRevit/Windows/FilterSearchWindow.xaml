<Window x:Class="MyInstrumentsForRevit.Windows.FilterSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить фильтр на вид"
        Width="560"
        Height="380"
        MinWidth="440"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchTextBox"
                 Height="28"
                 Margin="0,0,0,8"
                 VerticalContentAlignment="Center"
                 TextChanged="OnSearchTextChanged" />

        <ListBox x:Name="FilterListBox"
                 Grid.Row="1"
                 SelectionChanged="OnFilterSelectionChanged"
                 MouseDoubleClick="OnToggleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="40"
                                Height="20"
                                CornerRadius="3"
                                Background="{Binding StateBackground}">
                            <TextBlock Text="{Binding StateText}"
                                       Foreground="{Binding StateForeground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="0,8,0,8"
                   Foreground="#666666"
                   Text="Введите часть имени фильтра и выберите строку." />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="ToggleButton"
                    Content="Переключить"
                    Width="105"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="OnToggleClick" />
            <Button Content="Скрыть"
                    Width="90"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="OnHideClick" />
            <Button Content="Показать"
                    Width="90"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="OnShowClick" />
            <Button Content="Отмена"
                    Width="90"
                    Height="28"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
