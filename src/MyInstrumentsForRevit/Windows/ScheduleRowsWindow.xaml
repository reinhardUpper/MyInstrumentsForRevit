<Window x:Class="MyInstrumentsForRevit.Windows.ScheduleRowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="480" MinWidth="560" MinHeight="280"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="DescriptionTextBlock" Margin="0,0,0,8" Foreground="#555555" />
        <DataGrid x:Name="RowsGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                  SelectionUnit="FullRow" />
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="#555555" />
            <Button DockPanel.Dock="Right" Content="Закрыть" Width="90" Height="28" Click="OnCloseClick" />
            <Button DockPanel.Dock="Right" Content="Выбрать в модели" Width="145" Height="28" Margin="0,0,8,0" Click="OnSelectInModelClick" />
        </DockPanel>
    </Grid>
</Window>
