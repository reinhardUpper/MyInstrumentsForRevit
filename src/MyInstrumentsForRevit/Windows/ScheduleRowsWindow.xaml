<Window x:Class="MyInstrumentsForRevit.Windows.ScheduleRowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="480" MinWidth="560" MinHeight="280"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="DescriptionTextBlock" Margin="0,0,0,8" Foreground="#555555" />
        <DataGrid x:Name="RowsGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  SelectionUnit="FullRow" SelectionChanged="OnRowSelectionChanged" />
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Foreground="#555555" />
            <Button DockPanel.Dock="Right" Content="Закрыть" Width="90" Height="28" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
