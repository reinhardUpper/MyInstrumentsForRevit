<Window x:Class="MyInstrumentsForRevit.Windows.CommandInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Командная строка"
        Width="520"
        Height="260"
        MinWidth="420"
        MinHeight="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Введите команду и нажмите Enter. Для списка: help. Файл alias'ов: alias.path"
                   Margin="0,0,0,6"
                   Foreground="#666666" />

        <TextBox x:Name="CommandTextBox"
                 Grid.Row="1"
                 Height="30"
                 VerticalContentAlignment="Center"
                 TextChanged="OnCommandTextChanged"
                 KeyDown="OnCommandKeyDown" />

        <ListBox x:Name="SuggestionsListBox"
                 Grid.Row="2"
                 Margin="0,8,0,8"
                 DisplayMemberPath="SuggestionText"
                 KeyDown="OnSuggestionsKeyDown"
                 MouseDoubleClick="OnSuggestionDoubleClick" />

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="3"
                   Foreground="#666666"
                   Text="Доступные команды фильтруются по вводу." />
    </Grid>
</Window>
